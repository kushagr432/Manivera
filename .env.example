# ---------------------------------------------------------------------------
# Manivra Jewels — environment configuration
#
# Copy this file to .env and fill in real values:   cp .env.example .env
# .env is gitignored; .env.example is committed as the canonical var list.
#
# Anything prefixed VITE_ is INLINED INTO THE CLIENT BUNDLE by Vite and is
# therefore public. Never put a private secret behind a VITE_ prefix.
# ---------------------------------------------------------------------------

# --- Firebase -------------------------------------------------------------
# Console -> Project settings -> General -> Your apps -> SDK setup and config.
# These are publishable identifiers, not secrets; real protection comes from
# Firebase Auth plus your Firestore/Storage security rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# --- Cloudinary (client) --------------------------------------------------
# Used for unsigned image uploads from the admin panel. The upload preset must
# be marked "Unsigned" in Cloudinary -> Settings -> Upload.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=ml_default
VITE_CLOUDINARY_UPLOAD_FOLDER=jewelry-products

# --- Cloudinary (server-side only) ---------------------------------------
# NOT VITE_ prefixed on purpose: these never reach the browser. Only needed if
# you later add a backend that performs signed uploads or admin API calls.
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Site -----------------------------------------------------------------
# Public origin of this deployment, no trailing slash. Defaults to the browser
# origin when unset. Also add this domain to Firebase Console ->
# Authentication -> Settings -> Authorized domains, or login will be rejected.
VITE_SITE_URL=http://localhost:5173

# --- Admin panel ----------------------------------------------------------
# Where the admin panel is mounted. Change it to move the panel, e.g. /manage.
VITE_ADMIN_BASE_PATH=/admin

# Show the "Admin" link in the public site header. Set to false in production
# to keep the panel out of the public navigation.
VITE_SHOW_ADMIN_LINK=true

# --- Dev server -----------------------------------------------------------
# Extra hostnames the Vite dev server should accept (comma separated), for
# tunnels such as ngrok. Dev only; has no effect on a production build.
VITE_DEV_ALLOWED_HOSTS=
